+def bbox_ious(atlbrs, btlbrs):
+    # numpy replacement for cython_bbox.bbox_overlaps (same semantics: the
+    # +1 pixel convention on widths/heights, IoU over union of areas).
+    atlbrs = np.ascontiguousarray(atlbrs, dtype=np.float64)
+    btlbrs = np.ascontiguousarray(btlbrs, dtype=np.float64)
+    ious = np.zeros((len(atlbrs), len(btlbrs)), dtype=np.float64)
+    if ious.size == 0:
+        return ious
+    bw = btlbrs[:, 2] - btlbrs[:, 0] + 1
+    bh = btlbrs[:, 3] - btlbrs[:, 1] + 1
+    barea = bw * bh
+    for i, a in enumerate(atlbrs):
+        iw = np.minimum(a[2], btlbrs[:, 2]) - np.maximum(a[0], btlbrs[:, 0]) + 1
+        ih = np.minimum(a[3], btlbrs[:, 3]) - np.maximum(a[1], btlbrs[:, 1]) + 1
+        iw = np.maximum(iw, 0)
+        ih = np.maximum(ih, 0)
+        inter = iw * ih
+        aarea = (a[2] - a[0] + 1) * (a[3] - a[1] + 1)
+        ious[i] = inter / (aarea + barea - inter)
+    return ious

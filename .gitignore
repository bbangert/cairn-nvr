# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
cairn-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# phx.digest also digests everything else under priv/static — favicon, robots,
# images — writing a `<name>-<md5>.<ext>` copy and a .gz beside each original.
# The generator's two lines above only cover assets/, so without these a
# `mix assets.deploy` (tools/board-dev/push-code.sh runs one per push) leaves
# the tree dirty. The originals stay tracked; only the derived copies go.
/priv/static/**/*.gz
/priv/static/**/*-????????????????????????????????.*

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Database files
*.db
*.db-*


# Local runtime config + data
config.yml
/data/
/tmp/
.env.local

# Dialyzer PLTs
/priv/plts/

# The cairn-native cdylib, copied here from plugins/cairn-native/target/release
# so `Cairn.Native`'s @on_load finds it. A build artifact, not a source file.
/priv/native/

# Claude Code working files (plans, reviews, solutions) — local only.
.claude/
/profiles/

# board-pipeline working artifacts (clips are board/scratch staged, results are evidence trees)
/tools/board-pipeline/clips/
/tools/board-pipeline/ladder-results/

# Qualcomm AI Hub credentials (Ben, 2026-08-21) — never commit
qualcomm.env

# Sourced by bin/cairn before the VM starts — the only point early enough
# for glibc malloc tuning (runtime.exs runs inside an already-initialized
# allocator).
#
# The node runs ~48 threads and every ORT/QNN/Rust allocation rides glibc
# malloc, whose default arena budget (8 x cores) parks freed memory in
# per-thread 64 MB arena heaps instead of returning it — measured on the
# QCS6490 as a row of 64/62/32/30/28 MB anonymous VMAs inside a beam.smp
# RSS ~5x what the BEAM itself reports (memory A/B step A1;
# baseline: rss-pss-baseline-20260831.md). Two arenas keep contention
# bounded without the parking.
export MALLOC_ARENA_MAX=2
